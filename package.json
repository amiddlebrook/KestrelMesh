{
  "name": "portfolio-kestrelmesh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit && node --check public/app.js && node --check public/config.js",
    "test": "node scripts/compile-tests.mjs && node --test tests/smoke.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.50.0"
  }
}
